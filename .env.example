# Database Connection (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/aerodent

# Application Environment (development, testing, production)
AERODENT_ENV=development

# Server Session & CSRF Secret Key
SECRET_KEY=replace-with-a-long-random-secret-key-at-least-32-characters

# X-Ray Private File Storage: local filesystem directory, outside the web-served
# directory. Defaults to <project_root>/storage if unset. There is currently no
# pluggable cloud storage backend (S3/R2/MinIO) wired into the upload/download
# routes; only local disk storage is actually used.
AERODENT_STORAGE_PATH=storage

# Only set to True when deployed behind a reverse proxy that itself strips/overwrites any
# client-supplied X-Forwarded-For header. Otherwise a client can spoof this header to bypass
# the login/registration rate limiter and misattribute audit log entries.
TRUST_PROXY_HEADERS=False

# Session cookie Secure/HttpOnly/SameSite flags are not independently configurable via
# environment variables: HttpOnly and SameSite=Lax are always on, and Secure is enabled
# automatically whenever AERODENT_ENV=production.

# Note: there is no CORS support in this backend by design. The frontend is served
# same-origin from this same Flask app, and cross-origin state-changing requests are
# rejected via Origin/Referer checks (see backend/app.py).
